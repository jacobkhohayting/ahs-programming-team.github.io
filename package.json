{
  "name": "miniforces",
  "version": "1.0.0",
  "description": "A simple self-hosted Codeforces-style contest site with a built-in judge (C++, Python, Java).",
  "main": "server.js",
  "private": true,
  "engines": { "node": ">=22.5" },
  "scripts": {
    "start": "node --no-warnings=ExperimentalWarning server.js",
    "dev": "node --no-warnings=ExperimentalWarning --watch server.js",
    "test": "node --no-warnings=ExperimentalWarning --test \"test/*.test.js\""
  },
  "dependencies": {
    "express": "^5.1.0",
    "marked": "^18.0.0",
    "katex": "^0.16.22",
    "codemirror": "^5.65.19"
  }
}
